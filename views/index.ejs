<%- include('partials/header') %>

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1>Nhà Xe Dũng Thu</h1>
      <p>Di chuyển an toàn – Đúng giờ – Tận tâm phục vụ</p>
      <a href="/lich-trinh" class="btn btn-primary">Xem lịch trình</a>
    </div>
    <div class="hero-image">
      <img src="/images/bus-hero.svg" alt="Minh họa xe khách Nhà Xe Dũng Thu" width="600" height="420">
    </div>
  </div>
</section>

<section class="container features">
  <div class="feature-card">
    <div class="feature-icon">🛡️</div>
    <h3>An toàn</h3>
    <p>Đội xe được bảo dưỡng định kỳ, lái xe giàu kinh nghiệm.</p>
  </div>
  <div class="feature-card">
    <div class="feature-icon">⏰</div>
    <h3>Đúng giờ</h3>
    <p>Cam kết xuất bến và đến nơi đúng thời gian đã hẹn.</p>
  </div>
  <div class="feature-card">
    <div class="feature-icon">💺</div>
    <h3>Thoải mái</h3>
    <p>Ghế ngồi/giường nằm êm ái, có wifi và điều hòa.</p>
  </div>
  <div class="feature-card">
    <div class="feature-icon">💰</div>
    <h3>Giá tốt</h3>
    <p>Giá vé cạnh tranh, nhiều ưu đãi cho khách hàng thân thiết.</p>
  </div>
</section>

<section class="cta">
  <div class="container cta-inner">
    <h2>Sẵn sàng cho chuyến đi tiếp theo?</h2>
    <p>Liên hệ ngay để được tư vấn và đặt vé nhanh chóng.</p>
    <a href="/lien-he" class="btn btn-outline">Liên hệ ngay</a>
  </div>
</section>

<%- include('partials/footer') %>
