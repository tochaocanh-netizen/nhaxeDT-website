<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <h1>Lịch trình chạy xe</h1>
  </div>
</section>

<section class="container">
  <div class="table-wrap">
    <table class="schedule-table">
      <thead>
        <tr>
          <th>Điểm đi</th>
          <th>Điểm đến</th>
          <th>Giờ xuất bến</th>
          <th>Thời gian</th>
          <th>Giá vé</th>
        </tr>
      </thead>
      <tbody>
        <% routes.forEach(function(r) { %>
          <tr>
            <td><%= r.from %></td>
            <td><%= r.to %></td>
            <td><%= r.departs %></td>
            <td><%= r.duration %></td>
            <td><%= r.price %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="note">* Lịch trình có thể thay đổi theo mùa vụ. Vui lòng liên hệ hotline để được cập nhật chính xác nhất.</p>
</section>

<%- include('partials/footer') %>
